# Backend de ITSON Notify (ITN-27).
# Copia este archivo como backend/.env y llena los valores; `npm run dev` lo
# lee con node --env-file. Nunca hagas commit de .env.
# En Railway estas variables se capturan en las Variables del servicio del
# backend. SUPABASE_SERVICE_ROLE_KEY va SOLO aquí, nunca en el worker.

# Puerto HTTP
PORT=
# Llave compartida con el worker (header x-api-key). Mínimo 32 caracteres,
# p. ej. `openssl rand -hex 32`. La misma en el worker de ITN-25.
INTERNAL_API_KEY=
# Supabase > Project Settings > API
SUPABASE_URL=
# Supabase > Project Settings > API Keys > service_role
SUPABASE_SERVICE_ROLE_KEY=
# Llave maestra que cifra las credenciales de los estudiantes (ITN-36). Obligatoria:
# 32 bytes en base64, p. ej. `openssl rand -base64 32`. Va SOLO en el backend, nunca
# en el worker ni en el repo. Usa una distinta por entorno y guárdala aparte: si se
# pierde, las credenciales guardadas no se pueden recuperar.
CREDENTIALS_ENCRYPTION_KEY=

# Notificaciones (ITN-28). Opcionales: sin RESEND_API_KEY o sin
# NOTIFY_EMAIL_TO el canal email se omite y solo queda el canal log.
# Resend > API Keys. Nunca la pegues en logs ni en el repo.
RESEND_API_KEY=
# Destinatario de prueba de los avisos.
NOTIFY_EMAIL_TO=
# Remitente; vacío usa el de pruebas de Resend (onboarding@resend.dev).
NOTIFY_EMAIL_FROM=

# Google Classroom OAuth 2.0 (ITN-40, solo lectura).
# Valores permitidos en GOOGLE_OAUTH_ENABLED: true, false, 1, 0.
# Si GOOGLE_OAUTH_ENABLED=false (o 0), la integración queda deshabilitada sin consumir las demás variables.
# Si GOOGLE_OAUTH_ENABLED=true (o 1), o si está vacío y se define alguna variable GOOGLE_*,
# las cuatro se vuelven obligatorias y se validan en el arranque.
# GOOGLE_CLIENT_SECRET va SOLO en el backend, nunca en el frontend ni en el repo.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URI de redirección (https:// o http://localhost / http://127.0.0.1 en desarrollo local)
GOOGLE_REDIRECT_URI=
# Scope permitido: https://www.googleapis.com/auth/classroom.courses.readonly (sin scopes de escritura)
GOOGLE_OAUTH_SCOPES=
