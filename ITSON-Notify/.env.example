# Copia este archivo como .env (en esta misma carpeta) y llena los valores.
# Nunca hagas commit de .env.

# En Railway estas variables se capturan en Variables de cada servicio, nunca
# en el repo. Servicio worker-rpa (cron, ITN-25): solo Id_User, P_User,
# RPA_PAUSADO, BACKEND_URL, INTERNAL_API_KEY, ALUMNO_EMAIL,
# TELEGRAM_BOT_TOKEN y TELEGRAM_CHAT_ID.
# SUPABASE_SERVICE_ROLE_KEY, CREDENTIALS_ENCRYPTION_KEY y GOOGLE_AUTH_SECRET van
# solo en el backend, nunca en el worker ni en el frontend.

# --- Portal iVirtual (cuenta del alumno para la demo) ---
Id_User=
P_User=
# false para ver el navegador en local
HEADLESS=true

# --- Worker / cron de Railway (ITN-25) ---
# true detiene las extracciones sin borrar el cron (p. ej. tras cambio_password
# o credenciales rechazadas, para no sumar intentos fallidos a la cuenta)
RPA_PAUSADO=false
# Solo local, al correr `railway config plan/apply`: reemplaza el horario del
# cron definido en .railway/railway.ts (UTC). No se captura en Railway.
# ITN_CRON_SCHEDULE=0 0-6/2,14-22/2 * * *
# URL base del backend Express (ITN-27), sin la ruta. El worker manda a
# ${BACKEND_URL}/internal/grade-snapshots. Obligatoria para el cron.
BACKEND_URL=

# --- Alumno ---
# Email con el que se registra al alumno en app_users. El worker lo manda en
# user.email (nunca la matrícula). Obligatoria para el cron.
ALUMNO_EMAIL=
# Usuario de prueba para --simular-cambio (nunca el real)
ALUMNO_EMAIL_DEMO=

# --- Supabase ---
SUPABASE_URL=https://rgjzjhgwrkiisoyzjjtv.supabase.co
# Solo backend. Supabase > Project Settings > API Keys > service_role
SUPABASE_SERVICE_ROLE_KEY=

# --- Backend ---
PORT=3000
# Llave compartida entre el worker y el backend (header x-api-key), mínimo 32
# caracteres. Obligatoria para el cron y el backend.
INTERNAL_API_KEY=
# Llave maestra que cifra las credenciales de los estudiantes (ITN-36). Obligatoria
# para el backend: 32 bytes en base64, p. ej. `openssl rand -base64 32`. Va SOLO en
# el backend, nunca en el worker ni en el repo. Si se pierde, las credenciales
# guardadas no se pueden recuperar.
CREDENTIALS_ENCRYPTION_KEY=

# --- Correo (Resend). Si falta RESEND_API_KEY solo se usa el canal log ---
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=ITSON Notify <onboarding@resend.dev>

# --- Alertas técnicas al equipo por Telegram (ITN-38). Guía: docs/telegram-alertas.md ---
# Si falta alguna, sendTeamAlert no envía nada y el proceso sigue.
# Token que da @BotFather. Secreto: en Railway márcalo como sealed.
TELEGRAM_BOT_TOKEN=
# chat_id del grupo del equipo (los grupos empiezan con -, p. ej. -100...)
TELEGRAM_CHAT_ID=

# --- Google Classroom OAuth 2.0 (ITN-40, solo lectura) ---
# Valores permitidos en GOOGLE_OAUTH_ENABLED: true, false, 1, 0.
# Si GOOGLE_OAUTH_ENABLED=false (o 0), la integración queda deshabilitada sin consumir las demás variables.
# Si GOOGLE_OAUTH_ENABLED=true (o 1), o si está vacío y se define cualquiera de las demás variables,
# se activan las validaciones de todas las variables OAuth. Nunca uses scopes de escritura ni pegues secretos reales aquí.
GOOGLE_OAUTH_ENABLED=false
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=
# Secreto del cliente OAuth (solo en backend, nunca exponer al frontend)
GOOGLE_CLIENT_SECRET=
# URI de redirección autorizada (https:// en producción, o http://localhost / http://127.0.0.1 en desarrollo)
GOOGLE_REDIRECT_URI=
# Scope permitido (exclusivamente lectura de cursos): https://www.googleapis.com/auth/classroom.courses.readonly
GOOGLE_OAUTH_SCOPES=

# ITN-41: variables de aplicación (además del contrato OAuth de ITN-40 arriba).
# Para probar: GOOGLE_OAUTH_ENABLED=true, credenciales del cliente web,
# GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback (registrada en Google),
# GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/classroom.courses.readonly.
# ITN-41 agrega openid/email/profile únicamente para verificar la identidad.
# Secreto aleatorio de al menos 32 caracteres; generar con openssl rand -hex 32.
# Solo backend. Cifra refresh tokens y cookies; conservarlo estable y fuera del repo.
GOOGLE_AUTH_SECRET=
# URL de retorno del frontend; su origen exacto autoriza CORS y mutaciones de sesión.
FRONTEND_URL=http://localhost:5173
# lax para localhost o frontend/backend en el mismo sitio.
# none para sitios distintos: ambos deben usar HTTPS; cookies de terceros pueden bloquearse.
GOOGLE_COOKIE_SAME_SITE=lax
# VITE_BACKEND_URL va solo en el frontend (frontend/.env; Vite no lee este archivo).
# Es pública: origen del backend, sin /auth/google. Por defecto http://localhost:3000.
# VITE_USE_MOCK=true (frontend/.env) usa los datos simulados en lugar del backend.
